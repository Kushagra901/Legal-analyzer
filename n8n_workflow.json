      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1520,
        300
      ],
      "id": "check-ollama-healthy",
      "name": "IF (Ollama Healthy?)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $json.document_id || $('HTTP Request (Get Doc Info)').first().json.document_id || $('Webhook (Document Uploaded)').first().json.body.document_id }}/agent-analyze",
