{
  "name": "Legal Analyzer Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "document-uploaded",
        "responseMode": "onReceived",
        "isFullPath": true,
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "id": "webhook-trigger",
      "name": "Webhook (Document Uploaded)",
      "webhookId": "document-uploaded"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT '{{ $json.body.document_id }}'::text AS document_id, '{{ $json.body.filename }}'::text AS filename, '{{ $json.body.email }}'::text AS email, COALESCE((SELECT status FROM public.automation_runs WHERE document_id = '{{ $json.body.document_id }}'::uuid AND workflow_name = 'Legal Analyzer Pipeline'), 'not_started') AS status;",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        400,
        300
      ],
      "id": "check-idempotency",
      "name": "Postgres (Check Idempotency)",
      "credentials": {
        "postgres": {
          "id": "L8j2AWADDcZcwsa8",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "completed"
            },
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "running"
            }
          ]
        },
        "combineOperation": "any"
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        550,
        300
      ],
      "id": "check-already-running",
      "name": "IF (Already Running?)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.automation_runs (document_id, workflow_name, status) VALUES ('{{ $('Webhook (Document Uploaded)').first().json.body.document_id }}'::uuid, 'Legal Analyzer Pipeline', 'running') ON CONFLICT (document_id, workflow_name) DO UPDATE SET status = 'running' RETURNING document_id, status, '{{ $('Webhook (Document Uploaded)').first().json.body.filename }}'::text AS filename, '{{ $('Webhook (Document Uploaded)').first().json.body.email }}'::text AS email;",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        700,
        180
      ],
      "id": "mark-as-running",
      "name": "Postgres (Mark as Running)",
      "credentials": {
        "postgres": {
          "id": "L8j2AWADDcZcwsa8",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
