    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $json.document_id }}/escalate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "placeholder_internal_service_token"
            }
          ]
        },
        "options": {}
