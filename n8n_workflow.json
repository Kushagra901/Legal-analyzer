{
  "name": "Legal Analyzer Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "document-uploaded",
        "responseMode": "onReceived",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "id": "webhook-trigger",
      "name": "Webhook (Document Uploaded)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT $1::text AS document_id, $2::text AS filename, COALESCE((SELECT status FROM public.automation_runs WHERE document_id = $1 AND workflow_name = 'Legal Analyzer Pipeline'), 'not_started') AS status;",
        "queryParams": "={{ $json.body.document_id }}, {{ $json.body.filename }}"
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        400,
        300
      ],
      "id": "check-idempotency",
      "name": "Postgres (Check Idempotency)"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "completed"
            },
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "running"
            }
          ]
        },
        "combineOperation": "any"
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        550,
        300
      ],
      "id": "check-already-running",
      "name": "IF (Already Running?)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.automation_runs (document_id, workflow_name, status) VALUES ($1, 'Legal Analyzer Pipeline', 'running') ON CONFLICT (document_id, workflow_name) DO UPDATE SET status = 'running' RETURNING document_id, status, $2::text AS filename;",
        "queryParams": "={{ $json.document_id }}, {{ $json.filename }}"
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        700,
        180
      ],
      "id": "mark-as-running",
      "name": "Postgres (Mark as Running)"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $json.document_id }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        300
      ],
      "id": "get-document-data",
      "name": "HTTP Request (Get Doc Info)"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [],
          "number": [
            {
              "value1": "={{ $json.original_text.length }}",
              "operation": "larger",
              "value2": 200
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ],
      "id": "check-native-text",
      "name": "IF (Native Text Sufficient?)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $json.document_id }}/ocr",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1200,
        420
      ],
      "id": "run-ocr-fallback",
      "name": "HTTP Request (Run OCR Fallback)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $json.document_id }}/analyze",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1400,
        300
      ],
      "id": "run-llm-analysis",
      "name": "HTTP Request (LLM Clause Analysis)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $json.document_id }}/score",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1600,
        300
      ],
      "id": "run-risk-scoring",
      "name": "HTTP Request (Calculate Risk Score)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $json.document_id }}/compliance",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1800,
        300
      ],
      "id": "run-compliance-checks",
      "name": "HTTP Request (Check Compliance)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $json.document_id }}/report",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2000,
        300
      ],
      "id": "generate-report",
      "name": "HTTP Request (Generate Report)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $json.document_id }}/audit",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2200,
        300
      ],
      "id": "update-audit-log",
      "name": "HTTP Request (Update Audit Log)"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.safety_score }}",
              "operation": "smaller",
              "value2": 50
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        2400,
        300
      ],
      "id": "check-high-risk",
      "name": "IF (High Risk?)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $json.document_id }}/escalate",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2550,
        180
      ],
      "id": "create-reviewer-task",
      "name": "HTTP Request (Create Reviewer Task)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.automation_runs SET status = 'completed' WHERE document_id = $1 AND workflow_name = 'Legal Analyzer Pipeline';\nSELECT d.id AS document_id, d.filename, d.safety_score, r.status FROM public.documents d JOIN public.automation_runs r ON d.id = r.document_id WHERE d.id = $1 AND r.workflow_name = 'Legal Analyzer Pipeline';",
        "queryParams": "={{ $json.document_id }}"
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        2700,
        300
      ],
      "id": "mark-run-completed",
      "name": "Postgres (Mark Run Completed)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "Bearer re_placeholder_key"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "from",
              "value": "Legal Analyzer <notifications@yourdomain.com>"
            },
            {
              "name": "to",
              "value": "user@example.com"
            },
            {
              "name": "subject",
              "value": "=Document Analysis Complete: {{ $json.filename }}"
            },
            {
              "name": "html",
              "value": "=Your contract analysis for <strong>{{ $json.filename }}</strong> is ready.<br/>Safety Score: {{ $json.safety_score }}<br/><a href=\"http://localhost:3000/dashboard/documents/{{ $json.document_id }}\">View Analysis Dashboard</a>"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2900,
        300
      ],
      "id": "notify-user-email",
      "name": "HTTP Request (Send Email)"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        250,
        600
      ],
      "id": "error-trigger",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $node[\"Webhook (Document Uploaded)\"].json.body.document_id }}/audit",
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "action",
              "value": "=Workflow error in node '{{ $json.node.name }}': {{ $json.error.message }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        400,
        600
      ],
      "id": "log-failure",
      "name": "HTTP Request (Log Failure)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.automation_runs SET retry_count = retry_count + 1, status = 'failed_retry' WHERE document_id = $1 AND workflow_name = 'Legal Analyzer Pipeline';\nSELECT d.id AS document_id, d.filename, r.status, r.retry_count FROM public.documents d JOIN public.automation_runs r ON d.id = r.document_id WHERE d.id = $1 AND r.workflow_name = 'Legal Analyzer Pipeline';",
        "queryParams": "={{ $node[\"Webhook (Document Uploaded)\"].json.body.document_id }}"
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        550,
        600
      ],
      "id": "increment-retry",
      "name": "Postgres (Increment Retry)"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.retry_count }}",
              "operation": "largerEqual",
              "value2": 3
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        700,
        600
      ],
      "id": "check-retry-limit",
      "name": "IF (Retry Limit Reached?)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.automation_runs SET status = 'failed' WHERE document_id = $1 AND workflow_name = 'Legal Analyzer Pipeline';\nSELECT d.id AS document_id, d.filename, r.status FROM public.documents d JOIN public.automation_runs r ON d.id = r.document_id WHERE d.id = $1 AND r.workflow_name = 'Legal Analyzer Pipeline';",
        "queryParams": "={{ $node[\"Webhook (Document Uploaded)\"].json.body.document_id }}"
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        850,
        500
      ],
      "id": "mark-run-failed",
      "name": "Postgres (Mark Run Failed)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $node[\"Webhook (Document Uploaded)\"].json.body.document_id }}/audit",
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "action",
              "value": "=Max retries exceeded for document: {{ $node[\"Webhook (Document Uploaded)\"].json.body.filename }}. Status flagged as failed."
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1000,
        500
      ],
      "id": "notify-admin",
      "name": "HTTP Request (Notify Admin)"
    },
    {
      "parameters": {
        "amount": "={{ [30, 120, 600][($json.retry_count || 1) - 1] }}",
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        850,
        700
      ],
      "id": "wait-backoff",
      "name": "Wait (Backoff)"
    }
  ],
  "connections": {
    "Webhook (Document Uploaded)": {
      "main": [
        [
          {
            "node": "Postgres (Check Idempotency)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres (Check Idempotency)": {
      "main": [
        [
          {
            "node": "IF (Already Running?)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF (Already Running?)": {
      "main": [
        [],
        [
          {
            "node": "Postgres (Mark as Running)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres (Mark as Running)": {
      "main": [
        [
          {
            "node": "HTTP Request (Get Doc Info)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (Get Doc Info)": {
      "main": [
        [
          {
            "node": "IF (Native Text Sufficient?)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF (Native Text Sufficient?)": {
      "main": [
        [
          {
            "node": "HTTP Request (LLM Clause Analysis)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "HTTP Request (Run OCR Fallback)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (Run OCR Fallback)": {
      "main": [
        [
          {
            "node": "HTTP Request (LLM Clause Analysis)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (LLM Clause Analysis)": {
      "main": [
        [
          {
            "node": "HTTP Request (Calculate Risk Score)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (Calculate Risk Score)": {
      "main": [
        [
          {
            "node": "HTTP Request (Check Compliance)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (Check Compliance)": {
      "main": [
        [
          {
            "node": "HTTP Request (Generate Report)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (Generate Report)": {
      "main": [
        [
          {
            "node": "HTTP Request (Update Audit Log)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (Update Audit Log)": {
      "main": [
        [
          {
            "node": "IF (High Risk?)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF (High Risk?)": {
      "main": [
        [
          {
            "node": "HTTP Request (Create Reviewer Task)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Postgres (Mark Run Completed)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (Create Reviewer Task)": {
      "main": [
        [
          {
            "node": "Postgres (Mark Run Completed)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
