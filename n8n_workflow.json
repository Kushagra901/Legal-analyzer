{
  "name": "Legal Analyzer Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "document-uploaded",
        "responseMode": "onReceived",
        "isFullPath": true,
        "options": {},
        "authentication": "headerAuth",
        "headerAuth": {
          "name": "X-Webhook-Secret",
          "value": "={{ $env.INTERNAL_SERVICE_TOKEN }}"
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "id": "webhook-trigger",
      "name": "Webhook (Document Uploaded)",
      "webhookId": "document-uploaded",
      "credentials": {
        "httpHeaderAuth": {
          "id": "webhook-header-auth",
          "name": "X-Webhook-Secret"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT '{{ $json.body.document_id }}'::text AS document_id, '{{ $json.body.filename }}'::text AS filename, '{{ $json.body.email }}'::text AS email, COALESCE((SELECT status FROM public.automation_runs WHERE document_id = '{{ $json.body.document_id }}'::uuid AND workflow_name = 'Legal Analyzer Pipeline'), 'not_started') AS status;",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        400,
        300
      ],
      "id": "check-idempotency",
      "name": "Postgres (Check Idempotency)",
      "credentials": {
        "postgres": {
          "id": "L8j2AWADDcZcwsa8",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "completed"
            },
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "running"
            }
          ]
        },
        "combineOperation": "any"
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        550,
        300
      ],
      "id": "check-already-running",
      "name": "IF (Already Running?)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.automation_runs (document_id, workflow_name, status) VALUES ('{{ $('Webhook (Document Uploaded)').first().json.body.document_id }}'::uuid, 'Legal Analyzer Pipeline', 'running') ON CONFLICT (document_id, workflow_name) DO UPDATE SET status = 'running' RETURNING document_id, status, '{{ $('Webhook (Document Uploaded)').first().json.body.filename }}'::text AS filename, '{{ $('Webhook (Document Uploaded)').first().json.body.email }}'::text AS email;",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        700,
        300
      ],
      "id": "mark-as-running",
      "name": "Postgres (Mark as Running)",
      "credentials": {
        "postgres": {
          "id": "L8j2AWADDcZcwsa8",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $json.body?.document_id || $json.document_id || $('Webhook (Document Uploaded)').first().json.body.document_id }}/process",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_SERVICE_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        300
      ],
      "id": "process-document-pipeline",
      "name": "HTTP Request (Process Document)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated_doc AS (UPDATE public.documents SET status = 'completed' WHERE id = '{{ $json.document_id }}'::uuid RETURNING id, filename, safety_score, user_id), updated_run AS (UPDATE public.automation_runs SET status = 'completed' WHERE document_id = '{{ $json.document_id }}'::uuid AND workflow_name = 'Legal Analyzer Pipeline' RETURNING document_id, status) SELECT d.id AS document_id, d.filename, d.safety_score, u.status, COALESCE(usr.email, '{{ $('Webhook (Document Uploaded)').first().json.body.email }}', '') AS email FROM updated_run u JOIN updated_doc d ON d.id = u.document_id LEFT JOIN public.users usr ON usr.id = d.user_id;",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ],
      "id": "mark-run-completed",
      "name": "Postgres (Mark Run Completed)",
      "credentials": {
        "postgres": {
          "id": "L8j2AWADDcZcwsa8",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer re_placeholder_key"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"Legal Analyzer <notifications@yourdomain.com>\",\n  \"to\": \"{{ $json.email }}\",\n  \"subject\": \"Document Analysis Complete: {{ $json.filename }}\",\n  \"html\": \"Your contract analysis for <strong>{{ $json.filename }}</strong> is ready.<br/>Safety Score: {{ $json.safety_score }}<br/><a href=\\\"http://localhost:3000/dashboard/documents/{{ $json.document_id }}\\\">View Analysis Dashboard</a>\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1300,
        300
      ],
      "id": "notify-user-email",
      "name": "HTTP Request (Send Email)",
      "credentials": {
        "httpHeaderAuth": {
          "id": "NXMj4VsG5gpx7cYE",
          "name": "Header Auth account"
        }
      },
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        250,
        600
      ],
      "id": "error-trigger",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $('Webhook (Document Uploaded)').first().json.body.document_id }}/audit",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_SERVICE_TOKEN }}"
            }
          ]
        },
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "action",
              "value": "=Workflow error in node '{{ $json.node?.name || $json.execution?.lastNodeExecuted || 'Unknown Node' }}': {{ $json.error?.message || $json.execution?.error?.message || 'Execution error' }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        400,
        600
      ],
      "id": "log-failure",
      "name": "HTTP Request (Log Failure)",
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (UPDATE public.automation_runs SET retry_count = retry_count + 1, status = 'failed_retry' WHERE document_id = '{{ $('Webhook (Document Uploaded)').first().json.body.document_id }}'::uuid AND workflow_name = 'Legal Analyzer Pipeline' RETURNING document_id, status, retry_count) SELECT d.id AS document_id, d.filename, u.status, u.retry_count FROM updated u JOIN public.documents d ON d.id = u.document_id;",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        550,
        600
      ],
      "id": "increment-retry",
      "name": "Postgres (Increment Retry)",
      "credentials": {
        "postgres": {
          "id": "L8j2AWADDcZcwsa8",
          "name": "Postgres account"
        }
      },
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.retry_count }}",
              "operation": "largerEqual",
              "value2": 3
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        700,
        600
      ],
      "id": "check-retry-limit",
      "name": "IF (Retry Limit Reached?)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (UPDATE public.automation_runs SET status = 'failed' WHERE document_id = '{{ $('Webhook (Document Uploaded)').first().json.body.document_id }}'::uuid AND workflow_name = 'Legal Analyzer Pipeline' RETURNING document_id, status) SELECT d.id AS document_id, d.filename, u.status FROM updated u JOIN public.documents d ON d.id = u.document_id;",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        850,
        500
      ],
      "id": "mark-run-failed",
      "name": "Postgres (Mark Run Failed)",
      "credentials": {
        "postgres": {
          "id": "L8j2AWADDcZcwsa8",
          "name": "Postgres account"
        }
      },
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $('Webhook (Document Uploaded)').first().json.body.document_id }}/audit",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_SERVICE_TOKEN }}"
            }
          ]
        },
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "action",
              "value": "=Max retries exceeded for document: {{ $json.filename }}. Status flagged as failed."
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1000,
        500
      ],
      "id": "notify-admin",
      "name": "HTTP Request (Notify Admin)",
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "amount": "={{ [30, 120, 600][($json.retry_count || 1) - 1] }}",
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        850,
        700
      ],
      "id": "wait-backoff",
      "name": "Wait (Backoff)",
      "onError": "continueRegularOutput",
      "continueOnFail": true
    }
  ],
  "connections": {
    "Webhook (Document Uploaded)": {
      "main": [
        [
          {
            "node": "Postgres (Check Idempotency)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres (Check Idempotency)": {
      "main": [
        [
          {
            "node": "IF (Already Running?)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF (Already Running?)": {
      "main": [
        [],
        [
          {
            "node": "Postgres (Mark as Running)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres (Mark as Running)": {
      "main": [
        [
          {
            "node": "HTTP Request (Process Document)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (Process Document)": {
      "main": [
        [
          {
            "node": "Postgres (Mark Run Completed)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres (Mark Run Completed)": {
      "main": [
        [
          {
            "node": "HTTP Request (Send Email)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "HTTP Request (Log Failure)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (Log Failure)": {
      "main": [
        [
          {
            "node": "Postgres (Increment Retry)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres (Increment Retry)": {
      "main": [
        [
          {
            "node": "IF (Retry Limit Reached?)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF (Retry Limit Reached?)": {
      "main": [
        [
          {
            "node": "Postgres (Mark Run Failed)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait (Backoff)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres (Mark Run Failed)": {
      "main": [
        [
          {
            "node": "HTTP Request (Notify Admin)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
