      "id": "create-reviewer-task",
      "name": "HTTP Request (Create Reviewer Task)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (UPDATE public.automation_runs SET status = 'completed' WHERE document_id = '{{ $json.document_id }}'::uuid AND workflow_name = 'Legal Analyzer Pipeline' RETURNING document_id, status) SELECT d.id AS document_id, d.filename, d.safety_score, u.status, COALESCE(usr.email, '{{ $('Webhook (Document Uploaded)').first().json.body.email }}', '') AS email FROM updated u JOIN public.documents d ON d.id = u.document_id LEFT JOIN public.users usr ON usr.id = d.user_id;",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        2700,
        300
      ],
      "id": "mark-run-completed",
      "name": "Postgres (Mark Run Completed)",
      "credentials": {
        "postgres": {
          "id": "L8j2AWADDcZcwsa8",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer re_placeholder_key"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"Legal Analyzer <notifications@yourdomain.com>\",\n  \"to\": \"{{ $json.email }}\",\n  \"subject\": \"Document Analysis Complete: {{ $json.filename }}\",\n  \"html\": \"Your contract analysis for <strong>{{ $json.filename }}</strong> is ready.<br/>Safety Score: {{ $json.safety_score }}<br/><a href=\\\"http://localhost:3000/dashboard/documents/{{ $json.document_id }}\\\">View Analysis Dashboard</a>\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2900,
        300
