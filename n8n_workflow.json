          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "HTTP Request (Log Failure)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (Log Failure)": {
