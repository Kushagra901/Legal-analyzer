    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (UPDATE public.automation_runs SET retry_count = retry_count + 1, status = 'failed_retry' WHERE document_id = '{{ $('Webhook (Document Uploaded)').first().json.body.document_id }}'::uuid AND workflow_name = 'Legal Analyzer Pipeline' RETURNING document_id, status, retry_count) SELECT d.id AS document_id, d.filename, u.status, u.retry_count FROM updated u JOIN public.documents d ON d.id = u.document_id;",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        550,
        600
      ],
      "id": "increment-retry",
      "name": "Postgres (Increment Retry)",
      "credentials": {
        "postgres": {
          "id": "L8j2AWADDcZcwsa8",
          "name": "Postgres account"
        }
      },
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.retry_count }}",
              "operation": "largerEqual",
              "value2": 3
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        700,
        600
