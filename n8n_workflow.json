      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8000/api/v1/documents/{{ $('Webhook (Document Uploaded)').first().json.body.document_id }}/audit",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "placeholder_internal_service_token"
            }
          ]
        },
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "action",
              "value": "=Workflow error in node '{{ $json.node?.name || $json.execution?.lastNodeExecuted || 'Unknown Node' }}': {{ $json.error?.message || $json.execution?.error?.message || 'Execution error' }}"
            }
          ]
        },
        "options": {}
