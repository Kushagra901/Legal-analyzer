    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (UPDATE public.automation_runs SET status = 'failed' WHERE document_id = '{{ $('Webhook (Document Uploaded)').first().json.body.document_id }}'::uuid AND workflow_name = 'Legal Analyzer Pipeline' RETURNING document_id, status) SELECT d.id AS document_id, d.filename, u.status FROM updated u JOIN public.documents d ON d.id = u.document_id;",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        850,
        500
      ],
      "id": "mark-run-failed",
