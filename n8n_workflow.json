      "id": "notify-admin",
      "name": "HTTP Request (Notify Admin)",
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "amount": "={{ [30, 120, 600][($json.retry_count || 1) - 1] }}",
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        850,
        700
      ],
      "id": "wait-backoff",
      "name": "Wait (Backoff)",
      "onError": "continueRegularOutput",
      "continueOnFail": true
    }
