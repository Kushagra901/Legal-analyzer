# ==========================================
# Legal Analyzer - Backend Environment Config
# ==========================================

# Server Configuration
PROJECT_NAME="Legal Analyzer"
ENVIRONMENT="development"  # options: development, testing, production
API_V1_STR="/api/v1"
# WARNING: In production (ENVIRONMENT="production"), this MUST be replaced with a secure 256-bit key.
# Failure to change will prevent application startup: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY="placeholder_secret_key_change_me_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL="http://localhost:3000"

# Database (PostgreSQL + pgvector)
# Direct connection (Default for local PostgreSQL or migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legal"

# Supabase Transaction Pooler (Recommended for deployed environments with IPv4/serverless constraints)
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase Auth & Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# LLM Providers
ANTHROPIC_API_KEY="your-anthropic-api-key"
GEMINI_API_KEY="your-gemini-api-key"
OLLAMA_BASE_URL=""
OLLAMA_MODEL="qwen3:8b"

# Automation & Pipeline (n8n)
N8N_WEBHOOK_URL="http://localhost:5678/webhook/document-uploaded"
# WARNING: In production (ENVIRONMENT="production"), this MUST be replaced with a secure token.
# Failure to change will prevent application startup: python -c 'import secrets; print(secrets.token_hex(32))'
INTERNAL_SERVICE_TOKEN="placeholder_internal_service_token_change_me"

# Redis & Background Workers (Celery)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"

# Observability
SENTRY_DSN=""

# Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TOPIC_PREFIX="legal-analyzer"

# Databricks / Lakehouse (optional — for enterprise batch analytics)
DATABRICKS_HOST=""
DATABRICKS_TOKEN=""
DATABRICKS_CATALOG="legal_analyzer"

# SQL Server (optional — alternative database connectivity)
SQL_SERVER_CONNECTION_STRING=""
