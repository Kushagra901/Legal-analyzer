# ==========================================
# Legal Analyzer - Backend Environment Config
# ==========================================

# Server Configuration
PROJECT_NAME="Legal Analyzer"
API_V1_STR="/api/v1"
SECRET_KEY="placeholder_secret_key_change_me_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL="http://localhost:3000"

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legal"

# Supabase Auth & Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# LLM Providers
ANTHROPIC_API_KEY="your-anthropic-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Automation & Pipeline (n8n)
N8N_WEBHOOK_URL="http://localhost:5678/webhook/document-uploaded"
INTERNAL_SERVICE_TOKEN="placeholder_internal_service_token_change_me"

# Redis & Background Workers (Celery)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"

# Observability
SENTRY_DSN=""
